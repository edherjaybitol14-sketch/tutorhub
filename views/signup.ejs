<section class="container section auth-section">
  <div class="auth-card card">
    <h1>Create your account</h1>
    <p class="auth-sub">Join as a student to book lessons, or a tutor to start teaching.</p>
    <form method="POST" action="/signup" class="stacked-form">
      <label>Full name
        <input type="text" name="name" required />
      </label>
      <label>Email
        <input type="email" name="email" required />
      </label>
      <label>Password
        <input type="password" name="password" required minlength="6" />
      </label>
      <fieldset class="role-fieldset">
        <legend>I am a</legend>
        <label class="role-option">
          <input type="radio" name="role" value="student" checked /> Student
        </label>
        <label class="role-option">
          <input type="radio" name="role" value="tutor" /> Tutor
        </label>
      </fieldset>
      <button type="submit" class="btn btn-primary btn-block">Sign up</button>
    </form>
    <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
  </div>
</section>
