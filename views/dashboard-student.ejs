<section class="container section">
  <h1 class="page-title">Your dashboard</h1>
  <p class="page-sub">Signed in as <%= currentUser.name %> (student)</p>

  <div class="card">
    <h2>Upcoming sessions</h2>
    <% if (upcoming.length === 0) { %>
      <p class="empty-state">No sessions booked yet. <a href="/tutors">Find a tutor</a> to get started.</p>
    <% } else { %>
      <ul class="booking-list">
        <% upcoming.forEach(function(b) { %>
          <li class="booking-item">
            <div>
              <strong>with <a href="/tutors/<%= b.tutor_id %>"><%= b.tutor_name %></a></strong>
              <div class="booking-meta">
                <%= b.slot_date %> at <%= b.slot_time %>
                <% if (b.payment_status === 'paid') { %>
                  · <span class="paid-badge">Paid $<%= b.amount.toFixed(2) %></span>
                <% } %>
              </div>
            </div>
            <form method="POST" action="/bookings/<%= b.booking_id %>/cancel">
              <button type="submit" class="btn btn-outline btn-sm">Cancel</button>
            </form>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</section>
